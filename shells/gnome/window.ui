<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="AdwApplicationWindow" id="window">
    <property name="title">Transcribe</property>
    <property name="default-width">760</property>
    <property name="default-height">520</property>
    <property name="width-request">560</property>
    <property name="height-request">360</property>
    <property name="content">
      <object class="AdwToastOverlay" id="toasts">
        <property name="child">
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="title-widget">
                  <object class="AdwViewSwitcher">
                    <property name="stack">stack</property>
                    <property name="policy">wide</property>
                  </object>
                </property>
                <child type="start">
                  <object class="GtkButton" id="import">
                    <property name="icon-name">document-open-symbolic</property>
                    <property name="tooltip-text">Import audio</property>
                    <accessibility>
                      <property name="label">Import audio</property>
                    </accessibility>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkBox">
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="clock">
                        <property name="visible">false</property>
                        <style>
                          <class name="numeric"/>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="record">
                        <style>
                          <class name="suggested-action"/>
                        </style>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkStack" id="record_icon">
                                <child>
                                  <object class="GtkStackPage">
                                    <property name="name">record</property>
                                    <property name="child">
                                      <object class="GtkImage">
                                        <property name="icon-name">audio-input-microphone-symbolic</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkStackPage">
                                    <property name="name">stop</property>
                                    <property name="child">
                                      <object class="GtkImage">
                                        <property name="icon-name">media-playback-stop-symbolic</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkStackPage">
                                    <property name="name">busy</property>
                                    <property name="child">
                                      <object class="AdwSpinner"/>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkStackPage">
                                    <property name="name">done</property>
                                    <property name="child">
                                      <object class="GtkImage">
                                        <property name="icon-name">object-select-symbolic</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="record_label">
                                <property name="label">Record</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="cancel">
                        <property name="visible">false</property>
                        <property name="icon-name">window-close-symbolic</property>
                        <property name="tooltip-text">Cancel recording</property>
                        <accessibility>
                          <property name="label">Cancel recording</property>
                        </accessibility>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child type="top">
              <object class="GtkProgressBar" id="progress">
                <property name="visible">false</property>
                <style>
                  <class name="osd"/>
                </style>
              </object>
            </child>
            <property name="content">
              <object class="AdwViewStack" id="stack">
                <child>
                  <object class="AdwViewStackPage" id="history_page">
                    <property name="name">history</property>
                    <property name="title">History</property>
                    <property name="icon-name">document-open-recent-symbolic</property>
                    <property name="child">
                      <object class="AdwNavigationSplitView">
                        <property name="min-sidebar-width">240</property>
                        <property name="sidebar-width-fraction">0.32</property>
                        <property name="sidebar">
                          <object class="AdwNavigationPage">
                            <property name="title">History</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <child>
                                  <object class="GtkSearchEntry" id="search">
                                    <property name="placeholder-text">Search transcripts</property>
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <property name="margin-top">6</property>
                                    <property name="margin-bottom">6</property>
                                    <accessibility>
                                      <property name="label">Search history</property>
                                    </accessibility>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="margin-start">18</property>
                                    <property name="margin-end">18</property>
                                    <property name="margin-top">6</property>
                                    <property name="margin-bottom">6</property>
                                    <child>
                                      <object class="GtkLabel" id="list_heading">
                                        <property name="label">All transcripts</property>
                                        <property name="hexpand">true</property>
                                        <property name="xalign">0</property>
                                        <style>
                                          <class name="heading"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="list_count">
                                        <style>
                                          <class name="dim-label"/>
                                          <class name="numeric"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkScrolledWindow">
                                    <property name="vexpand">true</property>
                                    <property name="hscrollbar-policy">never</property>
                                    <property name="child">
                                      <object class="GtkListBox" id="entries">
                                        <style>
                                          <class name="navigation-sidebar"/>
                                        </style>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                        <property name="content">
                          <object class="AdwNavigationPage">
                            <property name="title">Transcript</property>
                            <property name="child">
                              <object class="GtkStack" id="detail">
                                <child>
                                  <object class="GtkStackPage">
                                    <property name="name">empty</property>
                                    <property name="child">
                                      <object class="AdwStatusPage">
                                        <property name="icon-name">audio-input-microphone-symbolic</property>
                                        <property name="title">No transcripts yet</property>
                                        <property name="child">
                                          <object class="GtkButton" id="empty_action">
                                            <property name="halign">center</property>
                                            <style>
                                              <class name="suggested-action"/>
                                              <class name="pill"/>
                                            </style>
                                          </object>
                                        </property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkStackPage">
                                    <property name="name">editor</property>
                                    <property name="child">
                                      <object class="GtkBox">
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">6</property>
                                        <property name="margin-start">12</property>
                                        <property name="margin-end">12</property>
                                        <property name="margin-top">6</property>
                                        <property name="margin-bottom">12</property>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="spacing">8</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label">Transcript</property>
                                                <style>
                                                  <class name="heading"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="entry_time">
                                                <style>
                                                  <class name="dim-label"/>
                                                  <class name="caption"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="not_pasted">
                                                <property name="label">Not pasted</property>
                                                <style>
                                                  <class name="caption"/>
                                                  <class name="warning"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkButton" id="copy">
                                                <property name="hexpand">true</property>
                                                <property name="halign">end</property>
                                                <property name="icon-name">edit-copy-symbolic</property>
                                                <property name="tooltip-text">Copy</property>
                                                <accessibility>
                                                  <property name="label">Copy</property>
                                                </accessibility>
                                                <style>
                                                  <class name="flat"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkButton" id="delete">
                                                <property name="icon-name">user-trash-symbolic</property>
                                                <property name="tooltip-text">Delete</property>
                                                <accessibility>
                                                  <property name="label">Delete</property>
                                                </accessibility>
                                                <style>
                                                  <class name="flat"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="entry_error">
                                            <property name="wrap">true</property>
                                            <property name="xalign">0</property>
                                            <style>
                                              <class name="error"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkScrolledWindow">
                                            <property name="vexpand">true</property>
                                            <property name="hscrollbar-policy">never</property>
                                            <style>
                                              <class name="card"/>
                                            </style>
                                            <property name="child">
                                              <object class="GtkTextView" id="text">
                                                <property name="wrap-mode">word-char</property>
                                                <property name="top-margin">12</property>
                                                <property name="bottom-margin">12</property>
                                                <property name="left-margin">12</property>
                                                <property name="right-margin">12</property>
                                                <accessibility>
                                                  <property name="label">Transcript</property>
                                                </accessibility>
                                                <style>
                                                  <class name="inline"/>
                                                </style>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="spacing">12</property>
                                            <child>
                                              <object class="GtkLabel" id="words">
                                                <style>
                                                  <class name="dim-label"/>
                                                  <class name="caption"/>
                                                  <class name="numeric"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="seconds">
                                                <style>
                                                  <class name="dim-label"/>
                                                  <class name="caption"/>
                                                  <class name="numeric"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwViewStackPage" id="settings_page">
                    <property name="name">settings</property>
                    <property name="title">Settings</property>
                    <property name="icon-name">emblem-system-symbolic</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <child>
                          <object class="AdwPreferencesGroup">
                            <child>
                              <object class="AdwPasswordEntryRow" id="azure_key">
                                <property name="title">Azure key</property>
                                <child type="suffix">
                                  <object class="GtkImage" id="azure_saved">
                                    <property name="icon-name">object-select-symbolic</property>
                                    <property name="tooltip-text">Saved</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwComboRow" id="microphone">
                                <property name="title">Microphone</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="streaming">
                                <property name="title">Streaming</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwComboRow" id="engine">
                                <property name="title">Cleanup</property>
                                <property name="model">
                                  <object class="GtkStringList">
                                    <items>
                                      <item>Off</item>
                                      <item>OpenRouter</item>
                                      <item>S1-mini by Superwhisper</item>
                                      <item>MAI-Transcribe-2</item>
                                    </items>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPasswordEntryRow" id="openrouter_key">
                                <property name="title">OpenRouter</property>
                                <child type="suffix">
                                  <object class="GtkImage" id="openrouter_saved">
                                    <property name="icon-name">object-select-symbolic</property>
                                    <property name="tooltip-text">Saved</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwEntryRow" id="model">
                                <property name="title">Cleanup model</property>
                                <child type="suffix">
                                  <object class="AdwSpinner" id="models_loading"/>
                                </child>
                                <child type="suffix">
                                  <object class="GtkLabel" id="models_error">
                                    <property name="label">Models unavailable</property>
                                    <style>
                                      <class name="error"/>
                                    </style>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkButton" id="models_retry">
                                    <property name="label">Retry</property>
                                    <property name="valign">center</property>
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkMenuButton" id="models_menu">
                                    <property name="icon-name">pan-down-symbolic</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Models</property>
                                    <accessibility>
                                      <property name="label">Models</property>
                                    </accessibility>
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                    <property name="popover">
                                      <object class="GtkPopover" id="models_popover">
                                        <property name="child">
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">6</property>
                                            <child>
                                              <object class="GtkSearchEntry" id="models_search">
                                                <accessibility>
                                                  <property name="label">Search models</property>
                                                </accessibility>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkScrolledWindow">
                                                <property name="hscrollbar-policy">never</property>
                                                <property name="propagate-natural-height">true</property>
                                                <property name="max-content-height">320</property>
                                                <property name="min-content-width">320</property>
                                                <property name="child">
                                                  <object class="GtkListBox" id="models_list">
                                                    <style>
                                                      <class name="navigation-sidebar"/>
                                                    </style>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                          </object>
                                        </property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwComboRow" id="effort">
                                <property name="title">Thinking level</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="s1_engine">
                                <property name="title">Engine</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="s1_model">
                                <property name="title">Model</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwComboRow" id="styling">
                                <property name="title">Styling</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwComboRow" id="unload">
                                <property name="title">Unload model</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="shortcut">
                                <property name="title">Shortcut</property>
                                <property name="activatable">true</property>
                                <child type="suffix">
                                  <object class="GtkButton" id="grant">
                                    <property name="label">Grant access</property>
                                    <property name="valign">center</property>
                                    <property name="visible">false</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="AdwSpinner" id="shortcut_spinner">
                                    <property name="visible">false</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkBox" id="shortcut_keys">
                                    <property name="spacing">4</property>
                                    <property name="valign">center</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkButton" id="shortcut_cancel">
                                    <property name="visible">false</property>
                                    <property name="icon-name">window-close-symbolic</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Cancel shortcut</property>
                                    <accessibility>
                                      <property name="label">Cancel shortcut</property>
                                    </accessibility>
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <child>
                              <object class="GtkButton" id="save">
                                <property name="label">Save</property>
                                <property name="halign">end</property>
                                <style>
                                  <class name="suggested-action"/>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup" id="updates">
                            <property name="visible">false</property>
                            <child>
                              <object class="AdwActionRow" id="version">
                                <child type="suffix">
                                  <object class="GtkLabel" id="update_status">
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkButton" id="update_action">
                                    <property name="valign">center</property>
                                    <property name="child">
                                      <object class="GtkBox">
                                        <property name="spacing">6</property>
                                        <child>
                                          <object class="AdwSpinner" id="update_spinner">
                                            <property name="visible">false</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="update_label"/>
                                        </child>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
