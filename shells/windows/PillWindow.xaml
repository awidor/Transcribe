<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Transcribe.PillWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Transcribe">
    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="Round" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="RoundAccent" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="Bar" TargetType="Rectangle">
                <Setter Property="Width" Value="2.5" />
                <Setter Property="Height" Value="4.9" />
                <Setter Property="RadiusX" Value="1.25" />
                <Setter Property="RadiusY" Value="1.25" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
        </Grid.Resources>

        <!-- One layout from the first word to the finished paste: the bars follow the voice, then
             settle while the transcript is prepared, and the stop button turns into a spinner and
             then a check. -->
        <Grid x:Name="SessionView" Padding="11,0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="CancelButton"
                AutomationProperties.Name="Cancel"
                Style="{StaticResource Round}"
                ToolTipService.ToolTip="Cancel">
                <FontIcon FontSize="10" Glyph="&#xE711;" />
            </Button>
            <StackPanel
                x:Name="Wave"
                Grid.Column="1"
                Height="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2.5">
                <Rectangle Style="{StaticResource Bar}" />
                <Rectangle Style="{StaticResource Bar}" />
                <Rectangle Style="{StaticResource Bar}" />
                <Rectangle Style="{StaticResource Bar}" />
                <Rectangle Style="{StaticResource Bar}" />
                <Rectangle Style="{StaticResource Bar}" />
                <Rectangle Style="{StaticResource Bar}" />
                <Rectangle Style="{StaticResource Bar}" />
                <Rectangle Style="{StaticResource Bar}" />
                <Rectangle Style="{StaticResource Bar}" />
                <Rectangle Style="{StaticResource Bar}" />
            </StackPanel>
            <ScrollViewer
                x:Name="WordsScroll"
                Grid.Column="2"
                VerticalAlignment="Center"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Said" FontSize="12" />
                    <TextBlock x:Name="Guess" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ScrollViewer>
            <TextBlock
                x:Name="Clock"
                Grid.Column="3"
                VerticalAlignment="Center"
                FontSize="11"
                FontWeight="Medium"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="Action" Grid.Column="4" Style="{StaticResource RoundAccent}">
                <Grid>
                    <FontIcon x:Name="StopIcon" FontSize="10" Glyph="&#xE71A;" />
                    <ProgressRing
                        x:Name="Busy"
                        Width="14"
                        Height="14"
                        MinWidth="14"
                        MinHeight="14" />
                    <FontIcon x:Name="DoneIcon" FontSize="12" Glyph="&#xE73E;" />
                </Grid>
            </Button>
        </Grid>

        <Grid
            x:Name="ErrorView"
            Padding="14,0,11,0"
            ColumnSpacing="8"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                x:Name="Failure"
                VerticalAlignment="Center"
                Background="Transparent"
                Orientation="Horizontal"
                Spacing="6">
                <FontIcon FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE783;" />
                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Error" />
            </StackPanel>
            <Button
                x:Name="HistoryButton"
                Grid.Column="1"
                Height="26"
                Padding="11,0"
                VerticalAlignment="Center"
                Content="History"
                CornerRadius="13"
                FontSize="11" />
            <Button
                x:Name="DismissError"
                Grid.Column="2"
                AutomationProperties.Name="Dismiss"
                Style="{StaticResource Round}"
                ToolTipService.ToolTip="Dismiss">
                <FontIcon FontSize="10" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!-- A transcript that could not be pasted is offered for dragging instead. -->
        <Grid
            x:Name="CardView"
            Padding="6,0,11,0"
            ColumnSpacing="4"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="Card"
                Background="Transparent"
                CanDrag="True"
                ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE76F;" />
                <TextBlock
                    x:Name="TranscriptText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Grid>
            <Button
                x:Name="DismissCard"
                Grid.Column="1"
                AutomationProperties.Name="Dismiss"
                Style="{StaticResource Round}"
                ToolTipService.ToolTip="Dismiss">
                <FontIcon FontSize="10" Glyph="&#xE711;" />
            </Button>
        </Grid>
    </Grid>
</Window>
