<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Transcribe.PillWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Transcribe">
    <Grid
        x:Name="Root"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Padding="12,8,8,8">
        <Grid.Resources>
            <Style x:Key="Icon" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- Only a hover fill, like the close buttons of the system's own flyouts. -->
            <Style x:Key="Subtle" BasedOn="{StaticResource Icon}" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
            <Style x:Key="Accent" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <!-- While recording: the microphone's level, the time, Stop and Cancel. Then a ring with
             what is happening, and a check once the text is in. -->
        <StackPanel x:Name="SessionView" Orientation="Horizontal" Spacing="8">
            <FontIcon
                x:Name="Microphone"
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE720;" />
            <ProgressRing
                x:Name="Busy"
                Width="16"
                Height="16"
                MinWidth="16"
                MinHeight="16"
                VerticalAlignment="Center" />
            <FontIcon
                x:Name="DoneIcon"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                Glyph="&#xE73E;" />
            <ProgressBar
                x:Name="Level"
                Width="64"
                VerticalAlignment="Center"
                Maximum="1" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" />
            <ScrollViewer
                x:Name="WordsScroll"
                Width="240"
                VerticalAlignment="Center"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Said" />
                    <TextBlock x:Name="Guess" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ScrollViewer>
            <Button
                x:Name="StopButton"
                AutomationProperties.Name="Stop"
                Style="{StaticResource Accent}"
                ToolTipService.ToolTip="Stop">
                <FontIcon FontSize="12" Glyph="&#xE71A;" />
            </Button>
            <Button
                x:Name="CancelButton"
                AutomationProperties.Name="Cancel"
                Style="{StaticResource Subtle}"
                ToolTipService.ToolTip="Cancel">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </StackPanel>

        <StackPanel
            x:Name="ErrorView"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                VerticalAlignment="Center"
                AutomationProperties.Name="Error"
                FontSize="16"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Glyph="&#xEB90;" />
            <TextBlock
                x:Name="Failure"
                MaxWidth="320"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="HistoryButton"
                VerticalAlignment="Center"
                Content="History" />
            <Button
                x:Name="DismissError"
                AutomationProperties.Name="Dismiss"
                Style="{StaticResource Subtle}"
                ToolTipService.ToolTip="Dismiss">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </StackPanel>

        <!-- A transcript that could not be pasted is offered for dragging instead. -->
        <StackPanel
            x:Name="CardView"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <StackPanel
                x:Name="Card"
                Background="Transparent"
                CanDrag="True"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE76F;" />
                <TextBlock
                    x:Name="TranscriptText"
                    Width="300"
                    VerticalAlignment="Center"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Name="DismissCard"
                AutomationProperties.Name="Dismiss"
                Style="{StaticResource Subtle}"
                ToolTipService.ToolTip="Dismiss">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
